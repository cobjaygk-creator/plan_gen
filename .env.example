# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# PPT pipeline (tools/classify_month.py) — Anthropic only, unaffected by
# Industry Brief's provider choice below.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic

# web/backend (FastAPI) — signs session cookies. Required in any real
# deployment; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Industry Brief article classifier + brief synthesis (web/backend/app/industry_brief/) —
# independent of AI_PROVIDER above, see those modules' docstrings.
OPENAI_API_KEY=
# BRIEF_AI_PROVIDER=openai
# BRIEF_CLASSIFIER_MODEL=gpt-4o-mini
# BRIEF_ANALYSIS_MODEL=gpt-4o

# 타사 이벤트/타사 사이트(event_bench, game_sites) 벤치마크 데이터 경로.
# 코드의 기본값은 web/backend/data/ 라 실서버에서 이 값을 안 맞춰주면
# 두 메뉴가 빈 화면으로 나온다.
#
# web/backend/data/ci/ (GitHub Actions의 uxtler-pages.yml이 커밋해두는
# 곳)를 쓰지 않는다 — 그 경로는 git으로 추적돼서, 서버 자체 스케줄러가
# 매시간 직접 수집·갱신한 내용을 다음 배포의 rsync(--delete)가 CI 쪽
# 스냅샷으로 그대로 덮어써버리는 문제가 실제로 있었다(예: 방금 수집한
# 이벤트가 다음 배포 후 사라짐). data/live/처럼 git과 무관한, 서버
# 로컬 전용 경로를 쓴다 — deploy-oci.yml의 rsync 제외 목록에도 같이
# 등록돼 있어야 한다.
# BENCHMARK_DATA_DIR=/opt/uxui/plan_gen/web/backend/data/live
