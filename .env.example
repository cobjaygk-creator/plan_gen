# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# PPT pipeline (tools/classify_month.py) — Anthropic only, unaffected by
# Industry Brief's provider choice below.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic

# web/backend (FastAPI) — signs session cookies. Required in any real
# deployment; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Industry Brief article classifier + brief synthesis (web/backend/app/industry_brief/) —
# independent of AI_PROVIDER above, see those modules' docstrings.
OPENAI_API_KEY=
# BRIEF_AI_PROVIDER=openai
# BRIEF_CLASSIFIER_MODEL=gpt-4o-mini
# BRIEF_ANALYSIS_MODEL=gpt-4o
